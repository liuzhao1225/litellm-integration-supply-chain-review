+
+    def json(self) -> _VaultSecretReadResponse: ...
+
+
+class _JsonObjectSource(Protocol):
+    """A Vault response whose body is a JSON object nothing further is assumed about."""
+
+    def json(self) -> dict[str, object]: ...
+
+
